<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lwa4p_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and robot configuration of the manipulation skill server for the LWA 4P:
    named poses, the MoveIt group, and the backends mock, Gazebo and Isaac Sim.
  </description>
  <maintainer email="165507983+dmitriiognev@users.noreply.github.com">Dmitrii Ognev</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lwa4p_gazebo</exec_depend>
  <exec_depend>lwa4p_moveit_config</exec_depend>
  <exec_depend>manipulation_isaac_sim</exec_depend>
  <exec_depend>manipulation_skill_server</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_task_constructor_capabilities</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
